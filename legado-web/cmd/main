#!/bin/bash
# Legado 阅读 - fnOS 生命周期脚本（启动/停止/状态）

NODE_BIN="${TRIM_APPDEST}/server/runtime/node/bin/node"
DATA_DIR="${TRIM_PKGVAR:-/var/apps/${TRIM_APPNAME:-legado-web}/var}"
PID_FILE="$DATA_DIR/app.pid"
LOG_FILE="$DATA_DIR/app.log"
SERVER="${TRIM_APPDEST}/server/server.bundle.js"
LOGFILE="${TRIM_TEMP_LOGFILE:-/dev/null}"
# Node 26：磁盘编译缓存由主线程和 worker_threads 共同继承，冷启动后的模块编译明显更少。
export NODE_COMPILE_CACHE="${NODE_COMPILE_CACHE:-$DATA_DIR/cache/node-compile-cache}"
export UV_THREADPOOL_SIZE="${UV_THREADPOOL_SIZE:-16}"
# Node 26 官方 Linux 二进制需要 libatomic；仅加载本应用私有运行库，不改系统环境。
NODE_RUNTIME_LIB="${TRIM_APPDEST}/server/runtime/node/lib"
if [ -d "$NODE_RUNTIME_LIB" ]; then
  export LD_LIBRARY_PATH="$NODE_RUNTIME_LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

is_running() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid=$(cat "$PID_FILE" 2>/dev/null)
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

do_start() {
  if is_running; then
    return 0
  fi

  if [ ! -x "$NODE_BIN" ] && [ -x "/var/apps/nodejs_v26/target/bin/node" ]; then
    NODE_BIN="/var/apps/nodejs_v26/target/bin/node"
  fi
  if [ ! -x "$NODE_BIN" ]; then
    NODE_BIN=$(command -v node 2>/dev/null)
  fi
  if [ -z "$NODE_BIN" ] || [ ! -x "$NODE_BIN" ]; then
    echo "未找到 Node.js 26 运行时（内置 runtime 或 nodejs_v26），请重新安装 debug FPK。" > "$LOGFILE"
    return 1
  fi
  if [ ! -f "$SERVER" ]; then
    echo "服务文件缺失：$SERVER" > "$LOGFILE"
    return 1
  fi

  mkdir -p "$DATA_DIR" "$NODE_COMPILE_CACHE" 2>/dev/null
  export TRIM_APPNAME TRIM_APPDEST TRIM_PKGVAR TRIM_SERVICE_PORT
  cd "$TRIM_APPDEST" || return 1

  nohup "$NODE_BIN" "$SERVER" >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 1

  if is_running; then
    return 0
  fi
  echo "Legado 阅读启动失败，日志：$LOG_FILE" > "$LOGFILE"
  return 1
}

do_stop() {
  if is_running; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    kill "$pid" 2>/dev/null
    local i=0
    while [ $i -lt 20 ] && kill -0 "$pid" 2>/dev/null; do
      sleep 0.2
      i=$((i + 1))
    done
    kill -9 "$pid" 2>/dev/null
  fi
  rm -f "$PID_FILE"
  # 清理网关 Socket，避免下次启动残留
  rm -f "${TRIM_APPDEST}/app.sock" 2>/dev/null
  return 0
}

case "$1" in
  start)
    do_start
    exit $?
    ;;
  stop)
    do_stop
    exit 0
    ;;
  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "$LOGFILE"
    exit 1
    ;;
esac
