#!/bin/bash
# Legado 阅读 - fnOS 生命周期脚本（启动/停止/状态）

NODE_BIN="/var/apps/nodejs_v22/target/bin/node"
DATA_DIR="${TRIM_PKGVAR:-/var/apps/legado-web/var}"
PID_FILE="$DATA_DIR/app.pid"
LOG_FILE="$DATA_DIR/app.log"
SERVER="${TRIM_APPDEST}/server/server.bundle.js"
LOGFILE="${TRIM_TEMP_LOGFILE:-/dev/null}"

is_running() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid=$(cat "$PID_FILE" 2>/dev/null)
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

do_start() {
  if is_running; then
    return 0
  fi

  if [ ! -x "$NODE_BIN" ]; then
    NODE_BIN=$(command -v node 2>/dev/null)
  fi
  if [ -z "$NODE_BIN" ] || [ ! -x "$NODE_BIN" ]; then
    echo "未找到 Node.js 运行时（nodejs_v22），请检查应用依赖是否安装成功。" > "$LOGFILE"
    return 1
  fi
  if [ ! -f "$SERVER" ]; then
    echo "服务文件缺失：$SERVER" > "$LOGFILE"
    return 1
  fi

  mkdir -p "$DATA_DIR" 2>/dev/null
  export TRIM_APPNAME TRIM_APPDEST TRIM_PKGVAR TRIM_SERVICE_PORT
  cd "$TRIM_APPDEST" || return 1

  nohup "$NODE_BIN" "$SERVER" >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 1

  if is_running; then
    return 0
  fi
  echo "Legado 阅读启动失败，日志：$LOG_FILE" > "$LOGFILE"
  return 1
}

do_stop() {
  if is_running; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    kill "$pid" 2>/dev/null
    local i=0
    while [ $i -lt 20 ] && kill -0 "$pid" 2>/dev/null; do
      sleep 0.2
      i=$((i + 1))
    done
    kill -9 "$pid" 2>/dev/null
  fi
  rm -f "$PID_FILE"
  # 清理网关 Socket，避免下次启动残留
  rm -f "${TRIM_APPDEST}/app.sock" 2>/dev/null
  return 0
}

case "$1" in
  start)
    do_start
    exit $?
    ;;
  stop)
    do_stop
    exit 0
    ;;
  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "$LOGFILE"
    exit 1
    ;;
esac
